<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:QuakeAssetManager"
             x:Class="QuakeAssetManager.AssetView">
  <Grid ColumnDefinitions="*,4,*,4,280">

    <!-- Active: the folder the game loads -->
    <DockPanel Grid.Column="0">
      <Border DockPanel.Dock="Top" Classes="headerbar">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <TextBlock x:Name="ActiveHeader" Classes="header" Text="{local:T 'Active'}" />
          <Button x:Name="OpenActive" Grid.Column="1" Classes="icon" Content="📂" Margin="6,0,0,0"
                  ToolTip.Tip="{local:T 'Open this folder in your file explorer'}" />
          <ToggleSwitch x:Name="ShowInvalid" Grid.Column="3" OnContent="{local:T 'Show invalid'}" OffContent="{local:T 'Show invalid'}"
                        ToolTip.Tip="{local:T 'Also show files the game never loads, and subfolders'}" />
        </Grid>
      </Border>
      <Border DockPanel.Dock="Top" Classes="help">
        <TextBlock Text="{local:T 'Active: this is your Quake folder. Files here are used by the game. The coloured label shows where each file came from: original (was there before), from &lt;folder&gt; (placed by the app), or invalid.'}" />
      </Border>
      <Border x:Name="MissingFolder" DockPanel.Dock="Top" Classes="missing" IsVisible="False">
        <StackPanel Spacing="8">
          <TextBlock x:Name="MissingText" TextWrapping="Wrap" />
          <Button x:Name="CreateFolder" Content="{local:T 'Create folder'}" />
        </StackPanel>
      </Border>
      <ListBox x:Name="ActiveList" SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:ActiveItem">
            <Grid ColumnDefinitions="Auto,*,Auto,62" Background="Transparent" ToolTip.Tip="{Binding Tip}">
              <Border Classes="thumb">
                <Panel>
                  <TextBlock Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding !HasThumbnail}" />
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                </Panel>
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Classes.invalid="{Binding IsInvalid}" />
              <TextBlock Grid.Column="2" Text="{Binding Badge}" Classes="badge" Margin="8,0,0,0"
                         Classes.bad="{Binding BadgeIsBad}" Classes.from="{Binding BadgeIsFrom}"
                         Classes.changed="{Binding BadgeIsChanged}" Classes.original="{Binding BadgeIsOriginal}" />
              <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Classes="date" ToolTip.Tip="{Binding ModifiedTip}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Width="1" />

    <!-- Assets (the options) or Online -->
    <DockPanel Grid.Column="2">
      <Border DockPanel.Dock="Top" Classes="headerbar">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
          <ToggleButton x:Name="AssetsTab" Classes="tab" Content="{local:T 'Local'}" IsChecked="True"
                        ToolTip.Tip="{local:T 'Your local copies of assets for this type (the Assets folder)'}" />
          <ToggleButton x:Name="OnlineTab" Grid.Column="1" Classes="tab" Content="{local:T 'Online'}"
                        ToolTip.Tip="{local:T 'Browse and download assets for this type from gfx.quakeworld.nu'}" />
          <Button x:Name="OpenAssets" Grid.Column="2" Classes="icon" Content="📂" Margin="2,0,0,0"
                  ToolTip.Tip="{local:T 'Open this folder in your file explorer'}" />
          <Button x:Name="NewFolder" Grid.Column="4" Content="{local:T 'New folder'}" ToolTip.Tip="{local:T 'Create an option folder'}" />
        </Grid>
      </Border>
      <Panel>
        <DockPanel x:Name="AssetsPanel">
          <TextBlock x:Name="AssetsHeader" DockPanel.Dock="Top" Classes="muted" Margin="10,4" />
          <Border DockPanel.Dock="Top" Classes="help">
            <TextBlock Text="{local:T 'Assets: your archive of options. The game doesn’t load these. Right-click, or use the buttons under the preview: Use this file, Use these (a whole folder), Rename, Delete. You can also drop zip/rar/7z files, folders or images on the window.'}" />
          </Border>
          <TreeView x:Name="AssetsTree" SelectionMode="Single">
            <TreeView.ItemContainerTheme>
              <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"
                            x:DataType="local:AssetNode">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </ControlTheme>
            </TreeView.ItemContainerTheme>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="local:AssetNode" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="Auto,*,Auto,62" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                  <Border Classes="thumb">
                    <Panel>
                      <TextBlock Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsVisible="{Binding !HasThumbnail}" />
                      <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                    </Panel>
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Classes.invalid="{Binding IsInvalid}" />
                  <TextBlock Grid.Column="2" Text="{Binding Badge}" Classes="badge" Margin="8,0,0,0"
                             Classes.ingame="{Binding BadgeIsInGame}" Classes.bad="{Binding BadgeIsBad}" />
                  <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Classes="date" ToolTip.Tip="{Binding ModifiedTip}" />
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
        <local:OnlineView x:Name="Online" IsVisible="False" />
      </Panel>
    </DockPanel>

    <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Width="1" />

    <!-- Preview -->
    <local:PreviewPanel x:Name="Preview" Grid.Column="4" />
  </Grid>
</UserControl>
