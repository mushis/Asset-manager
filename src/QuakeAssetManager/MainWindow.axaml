<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:QuakeAssetManager"
        x:Class="QuakeAssetManager.MainWindow"
        Title="Quake Asset Manager"
        Icon="/Assets/icon.ico"
        Width="1180" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="headerbar">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <WrapPanel x:Name="Tabs" Orientation="Horizontal">
            <ToggleButton x:Name="TabArchives" Classes="tab archives" Tag="archives"
                          ToolTip.Tip="{local:T 'Browse the PAK and PK3 files in your Quake folder and copy files from them to Local assets.'}" />
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
            <Button x:Name="TestButton" Content="▶  Test"
                    ToolTip.Tip="{local:T 'Start the client on the map from Settings so you can see your changes.'}" />
            <Button x:Name="SettingsButton" Classes="icon" Content="⚙"
                    ToolTip.Tip="{local:T 'Settings: folders, client, map, language, theme, asset types and tools.'}" />
            <ToggleButton x:Name="HelpButton" Classes="icon" Content="?"
                          ToolTip.Tip="{local:T 'Help: explain each area of the window.'}" />
            <Button x:Name="AboutButton" Classes="icon" Content="ⓘ"
                    ToolTip.Tip="{local:T 'About Quake Asset Manager'}" />
          </StackPanel>
        </Grid>
        <WrapPanel HorizontalAlignment="Right">
          <Border Classes="help" MaxWidth="300">
            <TextBlock Text="{local:T 'Asset types stay on top. Manage them from Settings. Archives: browse PAK and PK3 files in your active Quake folder.&#10;Drop zip/rar/7z files in this window to import them to your Local assets!'}" />
          </Border>
          <Border Classes="help" MaxWidth="260">
            <TextBlock Text="{local:T 'Test: launch your client on the map from Settings and see your changes in the game.'}" />
          </Border>
          <Border Classes="help" MaxWidth="220">
            <TextBlock Text="{local:T 'Settings: folders, client, test map, language and theme. Choose which asset types to show, and use the tools to fix file names and find duplicates.'}" />
          </Border>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0"
            Background="{DynamicResource ThemeHeaderBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Classes="muted" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="HintText" Grid.Column="1" Classes="muted" Margin="16,0,0,0" />
      </Grid>
    </Border>

    <Panel>
      <local:SetupView x:Name="Setup" IsVisible="False" />
      <local:AssetView x:Name="Assets" IsVisible="False" />
      <local:ArchivesView x:Name="Archives" IsVisible="False" />
      <TextBlock x:Name="LoadingText" Text="{local:T 'Reading game data…'}" IsVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
      <Border x:Name="DropOverlay" Classes="dropoverlay" IsVisible="False" IsHitTestVisible="False">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
          <TextBlock Text="{local:T 'Drop to add to Local assets'}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{local:T 'zip, pk3, rar, 7z, tar.gz, folders or image files. You’ll see a summary before anything is added.'}"
                     Opacity="0.8" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Panel>
  </DockPanel>
</Window>
