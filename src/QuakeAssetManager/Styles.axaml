<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Help bubbles, shown while help mode is on -->
  <Style Selector="Border.help">
    <Setter Property="Background" Value="#1A3B82F6" />
    <Setter Property="BorderBrush" Value="#803B82F6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.help > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.header">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#E5484D" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.ok">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#30A46C" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.badge">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Row labels: each kind keeps its own colour -->
  <Style Selector="TextBlock.badge.ingame"><Setter Property="Foreground" Value="#30A46C" /><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="TextBlock.badge.from"><Setter Property="Foreground" Value="#3B82F6" /><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="TextBlock.badge.original"><Setter Property="Opacity" Value="0.6" /></Style>
  <Style Selector="TextBlock.badge.changed"><Setter Property="Foreground" Value="#E8A33D" /><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="TextBlock.badge.bad"><Setter Property="Foreground" Value="#E5484D" /><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="TextBlock.date">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.thumb">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="#22808080" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="Border.dropoverlay">
    <Setter Property="Background" Value="#CC0B1220" />
    <Setter Property="BorderBrush" Value="#3B82F6" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Margin" Value="12" />
  </Style>

  <Style Selector="TextBlock.invalid">
    <Setter Property="Foreground" Value="#E5484D" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
  </Style>
  <Style Selector="Border.headerbar">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <Style Selector="ToggleButton.tab">
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>

  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinWidth" Value="30" />
  </Style>

  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Background" Value="#26F5A623" />
  </Style>
  <Style Selector="Border.missing">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="10" />
    <Setter Property="Background" Value="#14F5A623" />
  </Style>
</Styles>
