<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colours and corners come from the current theme (Themes/*.axaml). -->

  <Style Selector=":is(Window)">
    <Setter Property="Background" Value="{DynamicResource ThemeWindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
  </Style>
  <Style Selector="ListBox, TreeView">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Selected rows: a soft tint of the accent (the tree uses TreeViewItemBackgroundSelected from the theme) -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeSelectionHoverBrush}" />
  </Style>

  <!-- Help bubbles, shown while help mode is on -->
  <Style Selector="Border.help">
    <Setter Property="Background" Value="{DynamicResource ThemeHelpBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeHelpBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.help > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.header">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeInvalidBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.ok">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeInGameBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeWarnBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeInfoBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.badge">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Row labels: each kind keeps its own colour -->
  <Style Selector="TextBlock.badge.ingame"><Setter Property="Foreground" Value="{DynamicResource ThemeInGameBrush}" /></Style>
  <Style Selector="TextBlock.badge.bad"><Setter Property="Foreground" Value="{DynamicResource ThemeInvalidBrush}" /></Style>
  <Style Selector="TextBlock.badge.dup"><Setter Property="Foreground" Value="{DynamicResource ThemeWarnBrush}" /></Style>
  <Style Selector="TextBlock.date">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.thumb">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource ThemeThumbBrush}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="Border.dropoverlay">
    <Setter Property="Background" Value="{DynamicResource ThemeDropBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="Margin" Value="12" />
  </Style>
  <Style Selector="Border.frame">
    <Setter Property="Background" Value="{DynamicResource ThemeThumbBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
  </Style>

  <Style Selector="TextBlock.invalid">
    <Setter Property="Foreground" Value="{DynamicResource ThemeInvalidBrush}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
  </Style>
  <Style Selector="Border.headerbar">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Background" Value="{DynamicResource ThemeHeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource ThemeHeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
  </Style>
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <Style Selector="ToggleButton.tab">
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource TabCornerRadius}" />
  </Style>
  <!-- Archives isn't an asset type: outlined, with an icon and a gap before it -->
  <Style Selector="ToggleButton.archives">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.archives:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
  </Style>

  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinWidth" Value="30" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource ThemeInvalidBrush}" />
  </Style>

  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Background" Value="#26F5A623" />
  </Style>
  <Style Selector="Border.missing">
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="10" />
    <Setter Property="Background" Value="#14F5A623" />
  </Style>
</Styles>
