<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:QuakeAssetManager"
             x:Class="QuakeAssetManager.PreviewPanel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="headerbar">
      <TextBlock x:Name="Header" Classes="header" Text="{local:T 'Preview'}" />
    </Border>
    <Border DockPanel.Dock="Top" Classes="help">
      <TextBlock x:Name="HelpText" Text="{local:T 'Preview of the selected file and what you can do with it. For an alternative, the version the game uses now is shown below, for comparison.'}" />
    </Border>
    <ScrollViewer>
      <StackPanel Margin="10" Spacing="6">
        <TextBlock x:Name="Placeholder" Classes="muted" Text="{local:T 'Select a file to preview it.'}" TextWrapping="Wrap" />
        <TextBlock x:Name="Title" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="False" />
        <Border x:Name="MainFrame" Classes="frame" IsVisible="False">
          <Image x:Name="MainImage" Stretch="Uniform" MaxHeight="256" RenderOptions.BitmapInterpolationMode="None" />
        </Border>
        <TextBlock x:Name="MainInfo" Classes="muted" TextWrapping="Wrap" />
        <TextBlock x:Name="ModifiedInfo" Classes="muted" TextWrapping="Wrap" />
        <TextBlock x:Name="HintInfo" Classes="hint" IsVisible="False"
                   ToolTip.Tip="{local:T 'The client setting that decides whether this file is used. Set it in your client config or console.'}" />
        <TextBlock x:Name="WarningInfo" Classes="warn" IsVisible="False" />
        <StackPanel x:Name="CopiesBox" Spacing="2" IsVisible="False">
          <TextBlock Classes="warn" Text="{local:T 'Duplicate: the same file is also here (click to show it):'}" TextWrapping="Wrap" />
          <StackPanel x:Name="CopiesList" Spacing="2" />
        </StackPanel>
        <TextBlock x:Name="MainText" TextWrapping="Wrap" />
        <StackPanel x:Name="Actions" Spacing="6" Margin="0,4,0,0" />

        <StackPanel x:Name="CompareBox" Spacing="6" Margin="0,12,0,0" IsVisible="False">
          <TextBlock Classes="header" Text="{local:T 'In the game now'}" />
          <Border Classes="frame">
            <Image x:Name="CompareImage" Stretch="Uniform" MaxHeight="256" RenderOptions.BitmapInterpolationMode="None" />
          </Border>
          <TextBlock x:Name="CompareInfo" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
