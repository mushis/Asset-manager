<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:QuakeAssetManager"
             x:Class="QuakeAssetManager.SetupView">
  <ScrollViewer>
    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Width="640" Margin="20,24,20,20"
            Padding="24,20" CornerRadius="10" BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel>
        <TextBlock x:Name="Title" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="Subtitle" Classes="muted" TextWrapping="Wrap" Margin="0,4,0,10" />

        <Border x:Name="Banner" Classes="banner">
          <TextBlock x:Name="BannerText" TextWrapping="Wrap" />
        </Border>

        <TabControl x:Name="Tabs" Padding="0,8,0,0">
          <TabItem Header="{local:T 'General'}">
            <StackPanel>
              <TextBlock Classes="muted" Text="{local:T 'Quake folder'}" Margin="0,0,0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="QuakeBox" Watermark="C:\Games\nQuake"
                         ToolTip.Tip="{local:T 'The folder that contains id1 and qw.'}" />
                <Button x:Name="QuakeBrowse" Grid.Column="1" Content="{local:T 'Browse…'}" Margin="6,0,0,0" />
              </Grid>
              <TextBlock x:Name="QuakeError" Classes="error" Margin="0,4,0,0" />
              <TextBlock x:Name="QuakeOk" Classes="ok" Margin="0,4,0,0" Text="{local:T 'Found id1 and qw.'}" />

              <Border x:Name="MissingPanel" Classes="banner" Margin="0,8,0,0">
                <StackPanel Spacing="6">
                  <TextBlock x:Name="MissingText" TextWrapping="Wrap" />
                  <Button x:Name="CreateMissing" Content="{local:T 'Create missing folders'}" />
                </StackPanel>
              </Border>

              <TextBlock Classes="muted" Text="{local:T 'Local assets folder (archive)'}" Margin="0,14,0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="AssetsBox" Watermark="C:\Games\nQuake\assets"
                         ToolTip.Tip="{local:T 'Where the app keeps a copy of every asset. The game does not load this folder.'}" />
                <Button x:Name="AssetsBrowse" Grid.Column="1" Content="{local:T 'Browse…'}" Margin="6,0,0,0" />
              </Grid>
              <TextBlock x:Name="AssetsError" Classes="error" Margin="0,4,0,0" />
              <TextBlock x:Name="AssetsNote" Classes="muted" Margin="0,4,0,0" TextWrapping="Wrap" />

              <TextBlock Classes="muted" Text="{local:T 'Client'}" Margin="0,14,0,4" />
              <ComboBox x:Name="ClientBox" HorizontalAlignment="Stretch" PlaceholderText="{local:T 'Choose a client…'}"
                        ToolTip.Tip="{local:T 'Programs found in the Quake folder.'}" />
              <TextBlock x:Name="ClientError" Classes="error" Margin="0,4,0,0" />

              <TextBlock Classes="muted" Text="{local:T 'Map to open'}" Margin="0,14,0,4" />
              <TextBox x:Name="MapBox" Text="dm4" />
              <TextBlock x:Name="MapError" Classes="error" Margin="0,4,0,0" />
              <TextBlock x:Name="CommandText" Classes="muted" Margin="0,4,0,0" />

              <TextBlock Classes="muted" Text="{local:T 'Language'}" Margin="0,14,0,4" />
              <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch"
                        ToolTip.Tip="{local:T 'The language of the app. Folder names, file names and asset type names stay as they are.'}" />

              <TextBlock Classes="muted" Text="{local:T 'Theme'}" Margin="0,14,0,4" />
              <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch"
                        ToolTip.Tip="{local:T 'The colours and style of the app. It changes as you pick; Cancel goes back.'}" />

              <TextBlock Classes="muted" Text="{local:T 'Updates'}" Margin="0,14,0,4" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="CheckUpdatesButton" Content="{local:T 'Check for updates'}"
                        ToolTip.Tip="{local:T 'Look for a newer version on GitHub and install it'}" />
                <TextBlock x:Name="VersionText" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
              <CheckBox x:Name="UpdatesAtStartBox" Content="{local:T 'Check for updates when the app starts'}" Margin="0,6,0,0" />

              <CheckBox x:Name="ShowOnlineBox" Content="{local:T 'Show the Online tab'}" Margin="0,14,0,0"
                        ToolTip.Tip="{local:T 'Show the Local/Online switch above the Local assets list, to browse gfx.quakeworld.nu. When it is off, only your local copies are shown.'}" />
            </StackPanel>
          </TabItem>

          <TabItem Header="{local:T 'Asset types'}">
            <StackPanel Spacing="8">
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{local:T 'Choose which asset types have a tab. Hidden types are still recognised when you drop files. Everything about a type (folders, extensions, valid names, online lists) is in the configuration files below; restart the app after editing them.'}" />
              <ItemsControl x:Name="TypeList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:TypeRow">
                    <Border BorderThickness="0,0,0,1" Padding="0,6"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                      <Grid ColumnDefinitions="Auto,*">
                        <CheckBox IsChecked="{Binding Visible}" VerticalAlignment="Top" ToolTip.Tip="{Binding ShowTip}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Folders}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="ConfigPath" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal">
                <WrapPanel.Styles>
                  <Style Selector="Button"><Setter Property="Margin" Value="0,0,6,6" /></Style>
                </WrapPanel.Styles>
                <Button x:Name="OpenConfig" Content="{local:T 'Open configuration folder'}"
                        ToolTip.Tip="{local:T 'Open the folder with asset-types.json and the names files'}" />
                <Button x:Name="ShowAll" Content="{local:T 'Show all'}" ToolTip.Tip="{local:T 'Tick every asset type'}" />
                <Button x:Name="ShowDefaults" Content="{local:T 'Only the default five'}"
                        ToolTip.Tip="{local:T 'Models, BModels, HUD, Tracker and Particles'}" />
                <Button x:Name="RescanSubfolders" Content="{local:T 'Look for subfolders again'}"
                        ToolTip.Tip="{local:T 'Offer again the subfolders found in the game folders, including ones you skipped'}" />
              </WrapPanel>
            </StackPanel>
          </TabItem>

          <TabItem Header="{local:T 'Tools'}">
            <StackPanel Spacing="16">
              <TextBlock x:Name="ToolsNote" Classes="warn" IsVisible="False"
                         Text="{local:T 'Save your settings first: the tools need your Quake and Local assets folders.'}" />
              <Border Classes="card" Padding="14,12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{local:T 'Convert to lower case'}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="{local:T 'On Linux the game only finds files whose names match exactly, and it asks for lower-case names. This finds files with upper-case letters in both places: the game folders of every asset type in your Quake folder, and your Local assets folder. Each file is labelled with where it is, and only the ones you tick are renamed.'}" />
                  <Button x:Name="LowerCaseButton" Content="{local:T 'Find upper-case file names…'}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
              <Border Classes="card" Padding="14,12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{local:T 'Find duplicates in the active Quake folder'}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="{local:T 'Scans only the Quake folder set in General (its game folders and the .pak and .pk3 files inside them). The same path can exist in several places, for example id1/textures/abc.png and qw/textures/abc.png, or a loose file and one inside a pak/pk3, and the game uses only one of them. The list shows which one, lets you preview the copies, and can be saved as a text file. Nothing is changed.'}" />
                  <Button x:Name="DuplicatesButton" Content="{local:T 'Find duplicates…'}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
              <Border Classes="card" Padding="14,12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{local:T 'Find duplicates in the Local assets folders'}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="{local:T 'Scans every folder in your Local assets folder, for all asset types, for exact copies: files with the same name, extension and size whose contents are also identical. You choose which copy of each to keep; the others can be moved to the Recycle Bin, after a final list of what will be deleted.'}" />
                  <Button x:Name="AssetCopiesButton" Content="{local:T 'Find copies in Local assets…'}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </TabItem>
        </TabControl>

        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,16,0,0">
          <HyperlinkButton Content="{local:T 'Project page on GitHub'}" NavigateUri="https://github.com/mushis/Asset-manager"
                           ToolTip.Tip="https://github.com/mushis/Asset-manager" />
          <TextBlock Classes="muted" Text="·" VerticalAlignment="Center" />
          <HyperlinkButton Content="{local:T 'Wiki on QuakeWorld.nu'}" NavigateUri="https://www.quakeworld.nu/wiki/Quake_Asset_Manager"
                           ToolTip.Tip="https://www.quakeworld.nu/wiki/Quake_Asset_Manager" />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="{local:T 'Enter: save · Tab: next field'}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="CancelButton" Content="{local:T 'Cancel'}" />
            <Button x:Name="SaveButton" Classes="accent" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
